# Copy to /home/ec2-user/bolo/bolo.env on the box, mode 600. Never commit the real file.
BOLO_DB_PASSWORD=change-me
BOLO_PUBLIC_ORIGIN=https://bolo.eliooo.org
BOLO_SECURE_COOKIE=true

# Google sign-in (Firebase Auth). Public web config from Firebase → Project settings → Your apps → Web.
# Without all four, sign-in is off. No service account is needed.
BOLO_FIREBASE_API_KEY=
BOLO_FIREBASE_AUTH_DOMAIN=
BOLO_FIREBASE_PROJECT_ID=
BOLO_FIREBASE_APP_ID=
